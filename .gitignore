# SiteGround generates these in the domain root alongside the app. Ignoring
# them keeps `git status` clean on the server, so the deployed directory is a
# tidy working tree rather than one perpetually reporting untracked files.
/logs
/webstats
# /public_html/build is intentionally NOT ignored: this site is deployed
# without a build step, so the compiled Vite assets are committed. Run
# `npm run build` and commit public_html/build whenever resources/css or
# resources/js changes.
/public_html/fonts-manifest.dev.json
/public_html/hot
/public_html/storage
/storage/*.key
